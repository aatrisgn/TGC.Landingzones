resource "time_rotating" "rotate_after_a_year" {
  rotation_years = 1
}

resource "scaleway_registry_namespace" "main" {
  name        = "crn-shared-${var.environment}-scr-lz-fr-par"
  description = "Registry Namespace for landingzone - ${var.environment}"
  is_public   = false
  project_id  = data.scaleway_account_project.default_project.id
}

resource "scaleway_account_project" "product_project" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  name = "${each.key}-${each.value.location}"

  lifecycle {
    prevent_destroy = true
  }
}

resource "scaleway_iam_application" "application_project" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  name        = "app-${each.key}-spn"
  description = "Application for ${each.key}"
}

resource "scaleway_iam_policy" "product_project_policy" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  name           = "project-policy-${each.key}-spn-default-access"
  application_id = scaleway_iam_application.application_project[each.key].id

  rule {
    project_ids          = [scaleway_account_project.product_project[each.key].id]
    permission_set_names = ["AllProductsFullAccess"]
  }

  rule {
    organization_id      = var.organization_id
    permission_set_names = ["ProjectReadOnly"]
  }

  rule {
    project_ids          = [data.scaleway_account_project.default_project.id]
    permission_set_names = ["ContainerRegistryFullAccess", "ObjectStorageObjectsRead", "ObjectStorageObjectsWrite"]
  }
}

resource "scaleway_iam_api_key" "main" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  application_id     = scaleway_iam_application.application_project[each.key].id
  description        = "API key for product application"
  default_project_id = scaleway_account_project.product_project[each.key].id
  expires_at         = time_rotating.rotate_after_a_year.rotation_rfc3339
}

resource "scaleway_iam_api_key" "state_api_key" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  application_id     = scaleway_iam_application.application_project[each.key].id
  description        = "API key for state management"
  default_project_id = data.scaleway_account_project.default_project.id
  expires_at         = time_rotating.rotate_after_a_year.rotation_rfc3339
}

resource "github_repository" "product_repository" {
  for_each = { for product in var.Products : product.ProductName => product }

  name                   = "TGC.${each.value.ProductName}"
  description            = "Repository for ${each.value.ProductName}. Auto-generated by Landingzone."
  visibility             = "public"
  allow_squash_merge     = true
  allow_rebase_merge     = true
  allow_merge_commit     = false
  allow_forking          = false
  delete_branch_on_merge = true
  has_issues             = true


  template {
    owner                = "aatrisgn"
    repository           = "default_repository"
    include_all_branches = true
  }

  lifecycle {
    prevent_destroy = true
  }
}

module "claude_configuration" {
  for_each = github_repository.product_repository
  source   = "./modules/claude"

  repository_name            = each.value.name
  github_app_private_key     = data.scaleway_secret_version.github_app_private_key.data
  github_app_installation_id = data.scaleway_secret_version.github_app_installation_id.data
  claude_code_oauth_token    = data.scaleway_secret_version.claude_code_oauth_token.data
}

resource "github_repository_ruleset" "protect_main" {
  for_each    = github_repository.product_repository
  name        = "protect-main"
  repository  = each.value.name
  target      = "branch"
  enforcement = "active"
  conditions {
    ref_name {
      include = ["~DEFAULT_BRANCH"]
      exclude = []
    }
  }
  bypass_actors {
    actor_id    = 5 # repository admin role, so you can still work solo
    actor_type  = "RepositoryRole"
    bypass_mode = "always"
  }
  rules {
    deletion         = true
    non_fast_forward = true
    pull_request { required_approving_review_count = 1 }
  }
}

resource "github_actions_repository_permissions" "action_permissions" {
  for_each = github_repository.product_repository

  allowed_actions = "selected"
  allowed_actions_config {
    github_owned_allowed = true
    patterns_allowed     = ["aatrisgn/*", "azure/*", "docker/*"]
    verified_allowed     = false
  }
  repository = each.value.name
}

resource "github_actions_secret" "github_argocd_repo_write_token" {
  for_each = github_repository.product_repository

  repository  = each.value.name
  secret_name = "argocd_repo_write_token"
  value       = sensitive(base64decode(data.scaleway_secret_version.argocd_repository_write_key.data))
}



resource "github_actions_secret" "secret_organization_id" {
  for_each = {
    for product_environment in local.product_environments : product_environment.product_environment => product_environment if product_environment.needs_scaleway
  }

  #Should directly reference repositories
  repository  = "TGC.${each.value.product_name}"
  secret_name = "${replace(each.key, "-", "_")}_organization_id"
  value       = sensitive(var.organization_id)

  depends_on = [github_repository.product_repository]
}

